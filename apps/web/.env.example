VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional local-only dev auth fallback (only works in `npm run dev`):
VITE_ENABLE_DEV_AUTH=false

# If enabled and Supabase env vars are unset, dev login credentials are:
# email: dev@localhost  password: password
